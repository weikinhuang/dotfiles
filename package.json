{
  "name": "@weikinhuang/dotfiles",
  "version": "1.0.0",
  "private": true,
  "description": "My `$SHELL`, mostly bash, works everywhere, `*nix`, `osx`, `wsl`.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "oxlint": "oxlint --fix .",
    "prepare": "husky || true",
    "oxfmt": "oxfmt",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "markdownlint": "markdownlint-cli2 --fix '**/*.{md,mdc}' '.*/**/*.{md,mdc}'",
    "markdownlint:check": "markdownlint-cli2 '**/*.{md,mdc}' '.*/**/*.{md,mdc}'",
    "test": "vitest run",
    "test:watch": "vitest",
    "tsc": "tsc --noEmit"
  },
  "devDependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.81",
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "@eslint/json": "^2.1.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint": "^0.42.0",
    "markdownlint-cli2": "^0.24.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "quickjs-emscripten": "^0.32.0",
    "sharp": "^0.35.5",
    "typebox": "^1.4.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24"
  }
}
