// Baseline for ~/.config/opencode/opencode.jsonc (or <profile dir>/opencode.jsonc for `opencode -u <name>`).
// Copy / merge by hand; per-machine `model` and `providers` stay in the live file. See README.md.
{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "update": "notify",
  // Ordered rules; the last matching rule wins. These are appended after every built-in agent's own rules.
  // Shell commands ask by default, then the read-only allowlist mirrors config/claude/settings-baseline.json, then the
  // `.env` read denies come last so nothing earlier can re-allow them.
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "ag *", "effect": "allow" },
    { "action": "shell", "resource": "alias -p", "effect": "allow" },
    { "action": "shell", "resource": "alias", "effect": "allow" },
    { "action": "shell", "resource": "b2sum *", "effect": "allow" },
    { "action": "shell", "resource": "base64 *", "effect": "allow" },
    { "action": "shell", "resource": "basename *", "effect": "allow" },
    { "action": "shell", "resource": "bat *", "effect": "allow" },
    { "action": "shell", "resource": "case *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "cd *", "effect": "allow" },
    { "action": "shell", "resource": "chmod *", "effect": "allow" },
    { "action": "shell", "resource": "cksum *", "effect": "allow" },
    { "action": "shell", "resource": "cmp *", "effect": "allow" },
    { "action": "shell", "resource": "column *", "effect": "allow" },
    { "action": "shell", "resource": "comm *", "effect": "allow" },
    { "action": "shell", "resource": "command -v *", "effect": "allow" },
    { "action": "shell", "resource": "cp *", "effect": "allow" },
    { "action": "shell", "resource": "cut *", "effect": "allow" },
    { "action": "shell", "resource": "date *", "effect": "allow" },
    { "action": "shell", "resource": "df *", "effect": "allow" },
    { "action": "shell", "resource": "diff *", "effect": "allow" },
    { "action": "shell", "resource": "dirname *", "effect": "allow" },
    { "action": "shell", "resource": "dirs *", "effect": "allow" },
    { "action": "shell", "resource": "docker container ls *", "effect": "allow" },
    { "action": "shell", "resource": "docker image ls *", "effect": "allow" },
    { "action": "shell", "resource": "docker images *", "effect": "allow" },
    { "action": "shell", "resource": "docker info", "effect": "allow" },
    { "action": "shell", "resource": "docker inspect *", "effect": "allow" },
    { "action": "shell", "resource": "docker logs *", "effect": "allow" },
    { "action": "shell", "resource": "docker ps *", "effect": "allow" },
    { "action": "shell", "resource": "docker stats --no-stream *", "effect": "allow" },
    { "action": "shell", "resource": "docker version", "effect": "allow" },
    { "action": "shell", "resource": "du *", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "egrep *", "effect": "allow" },
    { "action": "shell", "resource": "env", "effect": "allow" },
    { "action": "shell", "resource": "false", "effect": "allow" },
    { "action": "shell", "resource": "fgrep *", "effect": "allow" },
    { "action": "shell", "resource": "file *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "fmt *", "effect": "allow" },
    { "action": "shell", "resource": "fold *", "effect": "allow" },
    { "action": "shell", "resource": "for *", "effect": "allow" },
    { "action": "shell", "resource": "gh auth status *", "effect": "allow" },
    { "action": "shell", "resource": "gh browse *", "effect": "allow" },
    { "action": "shell", "resource": "gh config get *", "effect": "allow" },
    { "action": "shell", "resource": "gh config list *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue list *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue status *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue view *", "effect": "allow" },
    { "action": "shell", "resource": "gh label list *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr checks *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr diff *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr list *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr status *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr view *", "effect": "allow" },
    { "action": "shell", "resource": "gh release list *", "effect": "allow" },
    { "action": "shell", "resource": "gh release view *", "effect": "allow" },
    { "action": "shell", "resource": "gh repo view *", "effect": "allow" },
    { "action": "shell", "resource": "gh ruleset list *", "effect": "allow" },
    { "action": "shell", "resource": "gh run list *", "effect": "allow" },
    { "action": "shell", "resource": "gh run view *", "effect": "allow" },
    { "action": "shell", "resource": "gh run watch *", "effect": "allow" },
    { "action": "shell", "resource": "gh search *", "effect": "allow" },
    { "action": "shell", "resource": "gh secret list *", "effect": "allow" },
    { "action": "shell", "resource": "gh status *", "effect": "allow" },
    { "action": "shell", "resource": "gh variable list *", "effect": "allow" },
    { "action": "shell", "resource": "gh workflow list *", "effect": "allow" },
    { "action": "shell", "resource": "gh workflow view *", "effect": "allow" },
    { "action": "shell", "resource": "git blame *", "effect": "allow" },
    { "action": "shell", "resource": "git cat-file *", "effect": "allow" },
    { "action": "shell", "resource": "git describe *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git grep *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-tree *", "effect": "allow" },
    { "action": "shell", "resource": "git reflog *", "effect": "allow" },
    { "action": "shell", "resource": "git remote -v", "effect": "allow" },
    { "action": "shell", "resource": "git remote get-url *", "effect": "allow" },
    { "action": "shell", "resource": "git remote show *", "effect": "allow" },
    { "action": "shell", "resource": "git remote", "effect": "allow" },
    { "action": "shell", "resource": "git rev-list *", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
    { "action": "shell", "resource": "git shortlog *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git stash list *", "effect": "allow" },
    { "action": "shell", "resource": "git stash show *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git submodule status *", "effect": "allow" },
    { "action": "shell", "resource": "git worktree list *", "effect": "allow" },
    { "action": "shell", "resource": "glab auth status *", "effect": "allow" },
    { "action": "shell", "resource": "glab ci list *", "effect": "allow" },
    { "action": "shell", "resource": "glab ci status *", "effect": "allow" },
    { "action": "shell", "resource": "glab ci trace *", "effect": "allow" },
    { "action": "shell", "resource": "glab ci view *", "effect": "allow" },
    { "action": "shell", "resource": "glab config get *", "effect": "allow" },
    { "action": "shell", "resource": "glab issue list *", "effect": "allow" },
    { "action": "shell", "resource": "glab issue view *", "effect": "allow" },
    { "action": "shell", "resource": "glab label list *", "effect": "allow" },
    { "action": "shell", "resource": "glab mr checkout *", "effect": "allow" },
    { "action": "shell", "resource": "glab mr diff *", "effect": "allow" },
    { "action": "shell", "resource": "glab mr list *", "effect": "allow" },
    { "action": "shell", "resource": "glab mr view *", "effect": "allow" },
    { "action": "shell", "resource": "glab release list *", "effect": "allow" },
    { "action": "shell", "resource": "glab release view *", "effect": "allow" },
    { "action": "shell", "resource": "glab repo search *", "effect": "allow" },
    { "action": "shell", "resource": "glab repo view *", "effect": "allow" },
    { "action": "shell", "resource": "glab variable list *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "hexdump *", "effect": "allow" },
    { "action": "shell", "resource": "hostname *", "effect": "allow" },
    { "action": "shell", "resource": "id -g", "effect": "allow" },
    { "action": "shell", "resource": "id -u", "effect": "allow" },
    { "action": "shell", "resource": "id", "effect": "allow" },
    { "action": "shell", "resource": "join *", "effect": "allow" },
    { "action": "shell", "resource": "jq *", "effect": "allow" },
    { "action": "shell", "resource": "locate *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "md5sum *", "effect": "allow" },
    { "action": "shell", "resource": "mkdir *", "effect": "allow" },
    { "action": "shell", "resource": "mv *", "effect": "allow" },
    { "action": "shell", "resource": "nl *", "effect": "allow" },
    { "action": "shell", "resource": "node --version", "effect": "allow" },
    { "action": "shell", "resource": "node -v", "effect": "allow" },
    { "action": "shell", "resource": "npm --version", "effect": "allow" },
    { "action": "shell", "resource": "npm -v", "effect": "allow" },
    { "action": "shell", "resource": "npm config get *", "effect": "allow" },
    { "action": "shell", "resource": "npm config list *", "effect": "allow" },
    { "action": "shell", "resource": "npm info *", "effect": "allow" },
    { "action": "shell", "resource": "npm list *", "effect": "allow" },
    { "action": "shell", "resource": "npm ls *", "effect": "allow" },
    { "action": "shell", "resource": "npm outdated *", "effect": "allow" },
    { "action": "shell", "resource": "npm view *", "effect": "allow" },
    { "action": "shell", "resource": "npx --version", "effect": "allow" },
    { "action": "shell", "resource": "npx oxlint *", "effect": "allow" },
    { "action": "shell", "resource": "od *", "effect": "allow" },
    { "action": "shell", "resource": "paste *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm --version", "effect": "allow" },
    { "action": "shell", "resource": "pnpm list *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm why *", "effect": "allow" },
    { "action": "shell", "resource": "popd *", "effect": "allow" },
    { "action": "shell", "resource": "printenv *", "effect": "allow" },
    { "action": "shell", "resource": "printf *", "effect": "allow" },
    { "action": "shell", "resource": "ps *", "effect": "allow" },
    { "action": "shell", "resource": "pushd *", "effect": "allow" },
    { "action": "shell", "resource": "pwd", "effect": "allow" },
    { "action": "shell", "resource": "readlink *", "effect": "allow" },
    { "action": "shell", "resource": "realpath *", "effect": "allow" },
    { "action": "shell", "resource": "rev", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "sed *", "effect": "allow" },
    { "action": "shell", "resource": "select *", "effect": "allow" },
    { "action": "shell", "resource": "set *", "effect": "allow" },
    { "action": "shell", "resource": "sha1sum *", "effect": "allow" },
    { "action": "shell", "resource": "sha256sum *", "effect": "allow" },
    { "action": "shell", "resource": "sha512sum *", "effect": "allow" },
    { "action": "shell", "resource": "shasum *", "effect": "allow" },
    { "action": "shell", "resource": "shopt *", "effect": "allow" },
    { "action": "shell", "resource": "sort *", "effect": "allow" },
    { "action": "shell", "resource": "stat *", "effect": "allow" },
    { "action": "shell", "resource": "tac *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "tee *", "effect": "allow" },
    { "action": "shell", "resource": "test *", "effect": "allow" },
    { "action": "shell", "resource": "touch *", "effect": "allow" },
    { "action": "shell", "resource": "tr *", "effect": "allow" },
    { "action": "shell", "resource": "tree *", "effect": "allow" },
    { "action": "shell", "resource": "true", "effect": "allow" },
    { "action": "shell", "resource": "type *", "effect": "allow" },
    { "action": "shell", "resource": "uname *", "effect": "allow" },
    { "action": "shell", "resource": "uniq *", "effect": "allow" },
    { "action": "shell", "resource": "uptime", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "which *", "effect": "allow" },
    { "action": "shell", "resource": "whoami", "effect": "allow" },
    { "action": "shell", "resource": "xxd *", "effect": "allow" },
    { "action": "shell", "resource": "yamllint *", "effect": "allow" },
    { "action": "shell", "resource": "yarn --version", "effect": "allow" },
