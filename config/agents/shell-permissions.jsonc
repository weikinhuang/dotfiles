// Canonical shell-command allowlist for every agent harness (Claude Code, opencode, Copilot CLI, Codex CLI).
// `config/agents/sync.ts generate` emits each harness's format from this file; pi's hand-written regex list
// (config/pi/bash-permissions-example.json) is checked against it by tests/config/agents/shell-permissions.spec.ts.
// Edit this file, then run `config/agents/sync.ts generate`. Schema and emit rules: config/agents/README.md.
//
// Entry fields:
//   pattern   Claude / opencode glob. `git status *` matches `git status` and `git status <args>`.
//   tier      `shared`: every harness (and must have a pi counterpart). `extras`: Claude and Codex only (file writes and
//             other commands that are not read-only).
//   except    Optional globs that must still ask although `pattern` allows them. Claude gets `permissions.ask` rules,
//             opencode gets later `ask` rules; Codex and Copilot cannot express them and skip the whole entry.
//   note      Optional risk note, emitted as a comment next to the rule (Claude: config/claude/README.md).
//   copilot   Optional reason the entry is not emitted for Copilot: `readonly` (copilot's built-in read-only tier
//             already auto-approves it) or `broader` (copilot's command identifier would match more than `pattern`).
//   codex     Optional `broader`: a Codex prefix rule would match more than `pattern` (exact patterns only).
{
  "entries": [
    { "pattern": "ag *", "tier": "shared" },
    { "pattern": "alias -p", "tier": "shared", "copilot": "broader" },
    { "pattern": "alias", "tier": "shared", "copilot": "broader" },
    { "pattern": "b2sum *", "tier": "shared" },
    { "pattern": "base64 *", "tier": "shared" },
    { "pattern": "basename *", "tier": "shared" },
    { "pattern": "bat *", "tier": "shared" },
    { "pattern": "cat *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "cd *", "tier": "shared" },
    { "pattern": "chmod *", "tier": "extras" },
    { "pattern": "cksum *", "tier": "shared" },
    { "pattern": "cmp *", "tier": "shared" },
    { "pattern": "column *", "tier": "shared" },
    { "pattern": "comm *", "tier": "shared" },
    { "pattern": "command -v *", "tier": "shared", "copilot": "broader" },
    { "pattern": "cp *", "tier": "extras" },
    { "pattern": "cut *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "date *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "df *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "diff *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "dirname *", "tier": "shared" },
    { "pattern": "dirs *", "tier": "shared" },
    { "pattern": "docker container ls *", "tier": "shared", "copilot": "broader" },
    { "pattern": "docker image ls *", "tier": "shared", "copilot": "broader" },
    { "pattern": "docker images *", "tier": "shared", "copilot": "broader" },
    { "pattern": "docker info", "tier": "shared", "copilot": "broader" },
    { "pattern": "docker logs *", "tier": "shared", "copilot": "broader" },
    { "pattern": "docker ps *", "tier": "shared", "copilot": "broader" },
    { "pattern": "docker stats --no-stream *", "tier": "shared", "copilot": "broader" },
    { "pattern": "docker version", "tier": "shared", "copilot": "broader" },
    { "pattern": "du *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "echo *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "egrep *", "tier": "shared" },
    { "pattern": "false", "tier": "shared", "copilot": "readonly" },
    { "pattern": "fgrep *", "tier": "shared" },
    { "pattern": "file *", "tier": "shared", "copilot": "readonly" },
    {
      "pattern": "find *",
      "tier": "shared",
      "note": "`-exec`, `-execdir`, `-ok`, and `-okdir` run commands, `-delete` removes files, and `-fprint` / `-fprintf` / `-fls` write files. Allowed outright for now; pi rejects those flags with a regex.",
      "copilot": "readonly",
    },
    { "pattern": "fmt *", "tier": "shared" },
    { "pattern": "fold *", "tier": "shared" },
    { "pattern": "gh auth status *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "gh browse *", "tier": "shared" },
    { "pattern": "gh config get *", "tier": "shared", "copilot": "broader" },
    { "pattern": "gh config list *", "tier": "shared", "copilot": "broader" },
    { "pattern": "gh issue list *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "gh issue status *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "gh issue view *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "gh label list *", "tier": "shared", "copilot": "broader" },
    { "pattern": "gh pr checks *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "gh pr diff *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "gh pr list *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "gh pr status *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "gh pr view *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "gh release list *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "gh release view *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "gh repo view *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "gh ruleset list *", "tier": "shared", "copilot": "broader" },
    { "pattern": "gh run list *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "gh run view *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "gh run watch *", "tier": "shared", "copilot": "broader" },
    { "pattern": "gh search *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "gh secret list *", "tier": "shared", "copilot": "broader" },
    { "pattern": "gh status *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "gh variable list *", "tier": "shared", "copilot": "broader" },
    { "pattern": "gh workflow list *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "gh workflow view *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "git blame *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "git branch --list *", "tier": "shared", "copilot": "broader" },
    { "pattern": "git cat-file *", "tier": "shared" },
    { "pattern": "git config --get *", "tier": "shared", "copilot": "broader" },
    { "pattern": "git describe *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "git diff *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "git grep *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "git log *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "git ls-files *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "git ls-tree *", "tier": "shared" },
    { "pattern": "git reflog *", "tier": "shared" },
    { "pattern": "git remote -v", "tier": "shared", "copilot": "readonly", "codex": "broader" },
    { "pattern": "git remote get-url *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "git remote show *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "git remote", "tier": "shared", "copilot": "readonly", "codex": "broader" },
    { "pattern": "git rev-list *", "tier": "shared" },
    { "pattern": "git rev-parse *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "git shortlog *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "git show *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "git stash list *", "tier": "shared", "copilot": "broader" },
    { "pattern": "git stash show *", "tier": "shared", "copilot": "broader" },
    { "pattern": "git status *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "git submodule status *", "tier": "shared", "copilot": "broader" },
    { "pattern": "git worktree list *", "tier": "shared", "copilot": "broader" },
    { "pattern": "glab auth status *", "tier": "shared", "copilot": "broader" },
    { "pattern": "glab ci list *", "tier": "shared", "copilot": "broader" },
    { "pattern": "glab ci status *", "tier": "shared", "copilot": "broader" },
    { "pattern": "glab ci trace *", "tier": "shared", "copilot": "broader" },
    { "pattern": "glab ci view *", "tier": "shared", "copilot": "broader" },
    { "pattern": "glab config get *", "tier": "shared", "copilot": "broader" },
    { "pattern": "glab issue list *", "tier": "shared", "copilot": "broader" },
    { "pattern": "glab issue view *", "tier": "shared", "copilot": "broader" },
    { "pattern": "glab label list *", "tier": "shared", "copilot": "broader" },
    { "pattern": "glab mr checkout *", "tier": "extras" },
    { "pattern": "glab mr diff *", "tier": "shared", "copilot": "broader" },
    { "pattern": "glab mr list *", "tier": "shared", "copilot": "broader" },
    { "pattern": "glab mr view *", "tier": "shared", "copilot": "broader" },
    { "pattern": "glab release list *", "tier": "shared", "copilot": "broader" },
    { "pattern": "glab release view *", "tier": "shared", "copilot": "broader" },
    { "pattern": "glab repo search *", "tier": "shared", "copilot": "broader" },
    { "pattern": "glab repo view *", "tier": "shared", "copilot": "broader" },
    { "pattern": "glab variable list *", "tier": "shared", "copilot": "broader" },
    { "pattern": "grep *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "head *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "hexdump *", "tier": "shared" },
    { "pattern": "hostname *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "id -g", "tier": "shared", "copilot": "readonly" },
    { "pattern": "id -u", "tier": "shared", "copilot": "readonly" },
    { "pattern": "id", "tier": "shared", "copilot": "readonly" },
    { "pattern": "join *", "tier": "shared" },
    { "pattern": "jq *", "tier": "shared" },
    { "pattern": "kubectl describe *", "tier": "shared", "copilot": "broader" },
    {
      "pattern": "kubectl get *",
      "tier": "shared",
      "except": ["kubectl get secret*", "kubectl get * secret*", "kubectl get *,secret*"],
    },
    { "pattern": "kubectl logs *", "tier": "shared", "copilot": "broader" },
    { "pattern": "locate *", "tier": "shared" },
    { "pattern": "ls *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "md5sum *", "tier": "shared" },
    { "pattern": "mkdir *", "tier": "extras" },
    { "pattern": "mv *", "tier": "extras" },
    { "pattern": "nl *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "node --version", "tier": "shared", "copilot": "broader" },
    { "pattern": "node -v", "tier": "shared", "copilot": "broader" },
    { "pattern": "npm --version", "tier": "shared" },
    { "pattern": "npm -v", "tier": "shared" },
    { "pattern": "npm config get *", "tier": "shared", "copilot": "broader" },
    { "pattern": "npm config list *", "tier": "shared", "copilot": "broader" },
    { "pattern": "npm info *", "tier": "shared" },
    { "pattern": "npm list *", "tier": "shared" },
    { "pattern": "npm ls *", "tier": "shared" },
    { "pattern": "npm outdated *", "tier": "shared" },
    { "pattern": "npm view *", "tier": "shared" },
    { "pattern": "npx --version", "tier": "shared" },
    { "pattern": "npx oxlint *", "tier": "extras" },
    { "pattern": "od *", "tier": "shared" },
    { "pattern": "paste *", "tier": "shared" },
    { "pattern": "pnpm --version", "tier": "shared" },
    { "pattern": "pnpm list *", "tier": "shared" },
    { "pattern": "pnpm why *", "tier": "shared" },
    { "pattern": "popd *", "tier": "shared" },
    { "pattern": "printf *", "tier": "shared" },
    { "pattern": "ps *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "pushd *", "tier": "shared" },
    { "pattern": "pwd", "tier": "shared", "copilot": "readonly" },
    { "pattern": "readlink *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "realpath *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "rev", "tier": "shared", "copilot": "broader" },
    { "pattern": "rg *", "tier": "shared", "copilot": "readonly" },
    {
      "pattern": "sed *",
      "tier": "shared",
      "note": "`-i` / `--in-place` edits files, and the `w` / `e` script commands write files / run commands. Allowed outright for now; pi rejects `-i` / `--in-place` with a regex.",
      "copilot": "readonly",
    },
    { "pattern": "sha1sum *", "tier": "shared" },
    { "pattern": "sha256sum *", "tier": "shared" },
    { "pattern": "sha512sum *", "tier": "shared" },
    { "pattern": "shasum *", "tier": "shared" },
    { "pattern": "shopt *", "tier": "shared" },
    { "pattern": "sort *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "stat *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "tac *", "tier": "shared" },
    { "pattern": "tail *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "tee *", "tier": "extras" },
    { "pattern": "test *", "tier": "shared" },
    { "pattern": "touch *", "tier": "extras" },
    { "pattern": "tr *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "tree *", "tier": "shared" },
    { "pattern": "true", "tier": "shared", "copilot": "readonly" },
    { "pattern": "type *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "uname *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "uniq *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "uptime", "tier": "shared", "copilot": "readonly" },
    { "pattern": "wc *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "which *", "tier": "shared", "copilot": "readonly" },
    { "pattern": "whoami", "tier": "shared", "copilot": "readonly" },
    { "pattern": "xxd *", "tier": "shared" },
    { "pattern": "yamllint *", "tier": "shared" },
    { "pattern": "yarn --version", "tier": "shared" },
    { "pattern": "yarn list *", "tier": "shared" },
    { "pattern": "yarn why *", "tier": "shared" },
    {
      "pattern": "yq *",
      "tier": "shared",
      "except": ["yq -i *", "yq * -i *", "yq --inplace *", "yq * --inplace *"],
      "note": "`-i` / `--inplace` edits files, so those forms ask. Bundled short flags such as `-Pi` are not caught outside pi.",
    },
  ],
}
