{
  // Example tts config. Copy to ~/.pi/agent/tts.json (global) or
  // <project>/.pi/tts.json (project layer; applied only when the project is
  // trusted). PI_TTS_URL overrides the top-level baseUrl below.
  //
  // The extension is dormant until a mode is enabled: PI_RP_TTS=1 (or
  // `/tts on`) for RP dialogue, PI_TTS_NARRATE=1 (or `/tts narrate on`) for
  // agent-output narration. Any failure (server down, no player, synth error)
  // degrades to a silent no-op.

  // LiteLLM in front of the llama.cpp Qwen3-TTS backend (include the /v1
  // suffix). One endpoint serves both clone and library voices.
  "baseUrl": "https://llm.example.com/v1",

  // LiteLLM key; `value` supports ${ENV} interpolation.
  "authHeader": { "name": "Authorization", "value": "Bearer ${PI_TTS_TOKEN}" },

  "api": "openai", // "openai" (llama.cpp via LiteLLM) or legacy "gpt-sovits"
  "model": "tts",
  "format": "wav", // wav (lowest latency) | pcm | mp3 | opus | aac | flac
  "player": "paplay", // file-mode playback command: paplay | afplay | ffplay | ...
  "requestTimeoutMs": 180000, // generous: survives a scale-from-zero cold start
  "maxChunkChars": 240, // narration chunk size (sentence/paragraph-bounded)
  "maxNarrationChunks": 40, // cap on chunks (or dual-voice cues) spoken per turn

  // Optional streaming playback: audio is piped into streamPlayer's stdin as
  // it arrives, so speech starts in about 2 s instead of after the whole
  // clip. streamPlayer must read from stdin (afplay and paplay cannot).
  // "stream": true,
  // "streamPlayer": ["ffplay", "-nodisp", "-autoexit", "-loglevel", "error", "-i", "-"],

  "voices": {
    // A clone voice driven via /v1/audio/voice-clone. refAudio is read
    // client-side and base64-encoded, so it must be a path on THIS machine
    // (not the server's filesystem). Keep clips at 30 s or less and refText
    // word for word: the transcript enables ICL cloning once the server
    // supports it (until then the server clones from the speaker embedding).
    "my-character": {
      "kind": "clone",
      "promptLang": "en",
      "refAudio": "~/voices/my-character/neutral.wav",
      "refText": "A transcript of the neutral reference clip, word for word.",
      // Optional emote-keyed reference clips. The turn's avatar emote selects
      // the first entry whose `match` list contains it, else the default
      // refAudio above is used.
      "emotes": [
        {
          "match": ["excited", "cheer", "victory", "happy"],
          "refAudio": "~/voices/my-character/excited.wav",
          "refText": "An upbeat, excited reference line."
        },
        {
          "match": ["sad", "tender", "calm", "gentle"],
          "refAudio": "~/voices/my-character/soft.wav",
          "refText": "A soft, gentle reference line."
        }
      ]
    },

    // A preset voice: a name or alias in the server's voice library (see
    // `/tts status` or GET /v1/audio/voices). OpenAI names such as `alloy`
    // are aliased server-side; an unknown name falls back to the library
    // default. The library entry sets the language.
    "narrator": {
      "kind": "preset",
      "preset": "alloy"
    }
  },

  // Which roster voice each mode uses. Set both to the same name for a
  // single-voice "audiobook" read (consecutive same-voice segments are
  // coalesced into continuous prose).
  "rpVoice": "my-character",
  "narrationVoice": "narrator"
}
