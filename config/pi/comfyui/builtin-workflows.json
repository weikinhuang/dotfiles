    "minimax-h3-fl2va-t2i": {
      "file": "minimax-h3-fl2va-t2i.api.json",
      "description": "MiniMax H3 FL2VA text-to-image, dual GPU, and H3 SageAttention; one still image, CFG fixed at 1",
      "tags": ["image", "minimax-h3", "multi-gpu", "sage"],
      "promptProtocol": "English prose for one still moment: style first (Live-action, cinematic / 2D-animated / watercolor), then subject, setting, composition, lighting. Quote visible text. No negative prompt: never write 'no X'; describe the wanted state (plain unpainted board, bare wall).",
      "inputs": {
        "prompt": {
          "node": "7",
          "key": "text"
        },
        "seed": {
          "node": "10",
          "key": "noise_seed"
        },
        "steps": {
          "node": "12",
          "key": "steps"
        },
        "width": {
          "node": "8",
          "key": "width"
        },
        "height": {
          "node": "8",
          "key": "height"
        }
      },
      "outputType": "image"
    },
    "minimax-h3-ref2va-edit": {
      "file": "minimax-h3-ref2va-edit.api.json",
      "description": "MiniMax H3 Ref2VA single-image editing with 1-9 references, dual GPU, and H3 SageAttention; CFG fixed at 1",
      "tags": ["image", "edit", "reference", "minimax-h3", "multi-gpu", "sage"],
      "promptProtocol": "Local edit: 'Edit <Picture 1>. Change only <target> to <new state>. Preserve <list>.' Subject in a new scene: H3 sections subject_definitions, summary ([reference generation] ...), retention_analysis, detailed_description, overall_soundscape, non_diegetic_music. <Picture N> follows inputImages order. No negative prompt; describe wanted states, not 'no X'.",
      "inputs": {
        "prompt": {
          "node": "7",
          "key": "prompt"
        },
        "seed": {
          "node": "10",
          "key": "noise_seed"
        },
        "steps": {
          "node": "12",
          "key": "steps"
        },
        "width": {
          "node": "17",
          "key": "value"
        },
        "height": {
          "node": "18",
          "key": "value"
        },
        "refImageSize": {
          "node": "7",
          "key": "ref_image_size"
        }
      },
      "images": {
        "mode": "autogrow",
        "loader": {
          "node": "16",
          "key": "image",
          "output": 0
        },
        "target": {
          "node": "7",
          "keyPrefix": "ref_images.ref_image_",
          "indexBase": 0
        },
        "min": 1,
        "max": 9
      },
      "outputType": "image"
    },
    "minimax-h3-ref2va-spectrum": {
      "file": "minimax-h3-ref2va-spectrum.api.json",
      "description": "MiniMax H3 Ref2VA video with native audio, dual-GPU placement, SageAttention, and Spectrum",
      "tags": ["video", "audio", "reference", "minimax-h3", "sage", "spectrum"],
      "promptProtocol": "English, H3 Ref2VA sections in order: subject_definitions, summary ([task type] ...), retention_analysis, detailed_description ([Shot 1] ...; later shots 'At MM:SS.mmm, the camera cuts to'), overall_soundscape, non_diegetic_music (or N/A). <Picture 1-9>, <Video 1-3>, <Audio 1-3> follow input order. Dialogue: '(S1) says: <d>[English] exact words</d>'. Quote on-screen text. No negative prompt; describe wanted states.",
      "inputs": {
        "prompt": {
          "node": "14",
          "key": "prompt"
        },
        "seed": {
          "node": "15",
          "key": "noise_seed"
        },
        "steps": {
          "node": "17",
          "key": "steps"
        },
        "width": {
          "node": "14",
          "key": "width"
        },
        "height": {
          "node": "14",
          "key": "height"
        },
        "duration": {
          "node": "14",
          "key": "length",
          "transform": "secondsToFrames24H3"
        },
        "refImageSize": {
          "node": "14",
          "key": "ref_image_size"
        }
      },
      "images": {
        "mode": "autogrow",
        "loader": {
          "node": "10",
          "key": "image",
          "output": 0
        },
        "target": {
          "node": "14",
          "keyPrefix": "ref_images.ref_image_",
          "indexBase": 0
        },
        "min": 0,
        "max": 9
      },
      "videos": {
        "mode": "autogrow",
        "templates": ["11", "12"],
        "loader": {
          "node": "11",
          "key": "file"
        },
        "outputs": [
          {
            "source": {
              "node": "12",
              "output": 0
            },
            "target": {
              "node": "14",
              "keyPrefix": "ref_videos.ref_video_",
              "indexBase": 0
            }
          },
          {
            "source": {
              "node": "12",
              "output": 1
            },
            "target": {
              "node": "14",
              "keyPrefix": "ref_video_audios.ref_video_audio_",
              "indexBase": 0
            }
          }
        ],
        "min": 0,
        "max": 3
      },
      "audios": {
        "mode": "autogrow",
        "templates": ["13"],
        "loader": {
          "node": "13",
          "key": "audio"
        },
        "outputs": [
          {
            "source": {
              "node": "13",
              "output": 0
            },
            "target": {
              "node": "14",
              "keyPrefix": "ref_audios.ref_audio_",
              "indexBase": 0
            }
          }
        ],
        "min": 0,
        "max": 3
      },
      "referenceConstraints": {
        "maxTotal": 12,
        "audioRequiresVisual": true
      },
      "outputType": "video"
    },
