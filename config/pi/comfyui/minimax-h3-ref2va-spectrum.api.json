{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_ref2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    },
    "_meta": { "title": "MiniMax H3 Ref2VA Model (GPU 0)" }
  },
  "2": {
    "class_type": "MiniMaxH3MemoryEfficientSageAttentionPatch",
    "inputs": { "model": ["1", 0] },
    "_meta": { "title": "MiniMax H3 Native SageAttention" }
  },
  "3": {
    "class_type": "SpectrumApplyMiniMaxH3",
    "inputs": {
      "model": ["2", 0],
      "enabled": true,
      "blend_weight": 0.5,
      "degree": 1,
      "ridge_lambda": 0.1,
      "window_size": 2.0,
      "flex_window": 0.75,
      "warmup_steps": 1,
      "tail_actual_steps": 1,
      "max_history": 8,
      "debug": true,
      "history_storage": "system_ram",
      "bootstrap_first_forecast": true,
      "anchor_residual_feedback": false,
      "selective_rollback_correction": false,
      "offline_smoothing_replay": true,
      "audio_blend_weight": 0.0,
      "offline_archive_storage": "system_ram",
      "model_aware_mode": "off",
      "model_aware_risk_threshold": 0.65
    },
    "_meta": { "title": "Spectrum MiniMax H3" }
  },
  "4": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    },
    "_meta": { "title": "MiniMax H3 Text Encoder" }
  },
  "5": {
    "class_type": "SelectCLIPDevice",
    "inputs": { "clip": ["4", 0], "device": "gpu:1" },
    "_meta": { "title": "Text Encoder on GPU 1" }
  },
  "6": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_video_vae_fp16.safetensors" },
    "_meta": { "title": "MiniMax H3 Video VAE" }
  },
  "7": {
    "class_type": "SelectVAEDevice",
    "inputs": { "vae": ["6", 0], "device": "gpu:1" },
    "_meta": { "title": "Video VAE on GPU 1" }
  },
  "8": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" },
    "_meta": { "title": "MiniMax H3 Audio VAE" }
  },
  "9": {
    "class_type": "SelectVAEDevice",
    "inputs": { "vae": ["8", 0], "device": "gpu:1" },
    "_meta": { "title": "Audio VAE on GPU 1" }
  },
  "10": {
    "class_type": "LoadImage",
    "inputs": { "image": "reference.png" },
    "_meta": { "title": "Reference Image Template" }
  },
  "11": {
    "class_type": "LoadVideo",
    "inputs": { "file": "reference.mp4" },
    "_meta": { "title": "Reference Video Template" }
  },
  "12": {
    "class_type": "GetVideoComponents",
    "inputs": { "video": ["11", 0] },
    "_meta": { "title": "Reference Video Components" }
  },
  "13": {
    "class_type": "LoadAudio",
    "inputs": { "audio": "reference.wav" },
    "_meta": { "title": "Standalone Audio Template" }
  },
  "14": {
    "class_type": "MiniMaxH3ReferenceToVideo",
    "inputs": {
      "clip": ["5", 0],
      "vae": ["7", 0],
      "audio_vae": ["9", 0],
      "prompt": "<Picture 1> moves naturally while <Video 1> guides motion and <Audio 1> guides sound.",
      "width": 608,
      "height": 352,
      "length": 56,
      "ref_image_size": "match",
      "ref_images.ref_image_0": ["10", 0],
      "ref_videos.ref_video_0": ["12", 0],
      "ref_video_audios.ref_video_audio_0": ["12", 1],
      "ref_audios.ref_audio_0": ["13", 0]
    },
    "_meta": { "title": "MiniMax H3 Reference to Video" }
  },
  "15": {
    "class_type": "RandomNoise",
    "inputs": { "noise_seed": 20260804 },
    "_meta": { "title": "Seed" }
  },
  "16": {
    "class_type": "KSamplerSelect",
    "inputs": { "sampler_name": "res_multistep" },
    "_meta": { "title": "Official H3 Sampler" }
  },
  "17": {
    "class_type": "BasicScheduler",
    "inputs": { "model": ["3", 0], "scheduler": "beta", "steps": 20, "denoise": 1.0 },
    "_meta": { "title": "Official H3 Schedule" }
  },
  "18": {
    "class_type": "BasicGuider",
    "inputs": { "model": ["3", 0], "conditioning": ["14", 0] },
    "_meta": { "title": "MiniMax H3 Guider" }
  },
  "19": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["15", 0],
      "guider": ["18", 0],
      "sampler": ["16", 0],
      "sigmas": ["17", 0],
      "latent_image": ["14", 1]
    },
    "_meta": { "title": "MiniMax H3 AV Sampling" }
  },
  "20": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["19", 0], "vae": ["7", 0] },
    "_meta": { "title": "Decode H3 Video" }
  },
  "21": {
    "class_type": "VAEDecodeAudio",
    "inputs": { "samples": ["19", 0], "vae": ["9", 0] },
    "_meta": { "title": "Decode H3 Stereo Audio" }
  },
  "22": {
    "class_type": "CreateVideo",
    "inputs": { "images": ["20", 0], "audio": ["21", 0], "fps": 24.0, "bit_depth": 8 },
    "_meta": { "title": "Create H3 AV Video" }
  },
  "23": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["22", 0],
      "filename_prefix": "video/MiniMax_H3",
      "format": "auto",
      "codec": "auto"
    },
    "_meta": { "title": "Save MiniMax H3 Video" }
  },
  "24": {
    "class_type": "ImageFromBatch",
    "inputs": { "image": ["20", 0], "batch_index": 0, "length": 1 },
    "_meta": { "title": "First Frame Preview" }
  },
  "25": {
    "class_type": "SaveImage",
    "inputs": { "images": ["24", 0], "filename_prefix": "video/MiniMax_H3_preview" },
    "_meta": { "title": "Save First Frame Preview" }
  }
}
